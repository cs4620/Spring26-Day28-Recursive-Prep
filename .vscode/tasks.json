{
  "tasks": [
    {
      "label": "C/C++: g++.exe build active file",
      "command": "g++",
      "args": [
        "-g",
        "ray-tracer.cpp",
        "triangle.cpp",
        "vector3.cpp",
        "-o",
        "ray-tracer.exe"
      ]
    },
    {
      "type": "cppbuild",
      "label": "C/C++: cl.exe build active file",
      "command": "cl.exe",
      "args": [
        "/Zi",
        "/EHsc",
        "/nologo",
        "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
        "${file}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}